# ===============================================
# CivicEye - Top-level Environment Reference
# ===============================================

# 1. Frontend (Vite, Port: 5173)
VITE_API_BASE_URL=http://localhost:8080

# 2. Spring Boot Backend (Port: 8080)
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_TIMEOUT_MS=30000

# 3. Messaging Adapter Configuration (SMS / WhatsApp)
# Options: mock | twilio | whatsapp
CIVICEYE_MESSAGING_PROVIDER=mock
CIVICEYE_TEST_RECIPIENT=+15551234567

# Automated Follow-Up Scheduler (Stage H)
# Development interval: 2 minutes; Production: 2880 (2 days)
CIVICEYE_FOLLOW_UP_DELAY_MINUTES=2

# Escalation Authority Contact (Stage J)
CIVICEYE_ESCALATION_RECIPIENT=+15559998888

# Twilio SMS Credentials (Optional, when CIVICEYE_MESSAGING_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE=+15550001111

# Meta WhatsApp Cloud API Credentials (Optional, when CIVICEYE_MESSAGING_PROVIDER=whatsapp)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=civiceye_webhook_secret_token

# 4. Python AI Engine (FastAPI, Port: 8000)
AI_HOST=127.0.0.1
AI_PORT=8000
GEMMA_API_KEY=your_google_gemma_api_key_here
GEMMA_MODEL=gemma-4-26b-a4b-it
DEMO_MODE_DEFAULT=false

# 5. OpenStreetMap & Maps
# Uses public Leaflet with OpenStreetMap tiles & Nominatim reverse geocoding (no private API key required)

# 6. Optional Production PostgreSQL (Future JPA persistence)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/civiceye_db
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres
