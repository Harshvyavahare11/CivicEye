# ===============================================
# CivicEye - Top-level Environment Reference
# ===============================================

# 1. Frontend (Vite, Port: 5173)
VITE_API_BASE_URL=http://localhost:8080

# 2. Spring Boot Backend (Port: 8080)
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_TIMEOUT_MS=30000

# 3. Python AI Engine (FastAPI, Port: 8000)
AI_HOST=127.0.0.1
AI_PORT=8000
GEMMA_API_KEY=your_google_gemma_api_key_here
GEMMA_MODEL=gemma-4-26b-a4b-it
DEMO_MODE_DEFAULT=false

# 4. Optional Production PostgreSQL (Future JPA persistence)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/civiceye_db
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres
