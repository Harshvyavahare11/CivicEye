# CivicEye AI-Engine Environment Configuration
AI_HOST=127.0.0.1
AI_PORT=8000

# Hosted Google Gemma 4 API Configuration
# Get your API key from Google AI Studio / Cloud
GEMMA_API_KEY=your_gemma_api_key_here
GEMMA_MODEL=gemma-4-26b-a4b-it

# Set to true to enable demo simulation by default when API key is missing
DEMO_MODE_DEFAULT=false
